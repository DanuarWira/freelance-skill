# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# LLM / Hermes API Configuration (Compatible with OpenAI / OpenRouter / vLLM / Local Hermes)
OPENAI_API_KEY=your_openai_or_openrouter_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
# Rekomendasi model: nousresearch/hermes-3-llama-3.1-405b, hermes-3-llama-3.1-70b, gpt-4o, etc.
HERMES_MODEL=gpt-4o

# Scraper Settings
PUPPETEER_HEADLESS=true
MAX_REVISION_CYCLES=2
